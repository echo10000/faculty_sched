DEBUG=True
SECRET_KEY=replace-with-a-generated-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Manila
INSTITUTION_NAME=Negros Oriental State University - Bais Campus
