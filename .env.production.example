# Example only. Set real values through the deployment secret manager or a private .env.
DEBUG=False
SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-50-characters
ALLOWED_HOSTS=campusload.example.edu
CSRF_TRUSTED_ORIGINS=https://campusload.example.edu
TIME_ZONE=Asia/Manila
INSTITUTION_NAME=Negros Oriental State University - Bais Campus
DB_NAME=campusload
DB_USER=campusload_app
DB_PASSWORD=replace-with-a-private-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=require
DB_CONN_MAX_AGE=60
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
# Enable these only when every subdomain is HTTPS and preload eligibility is reviewed.
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# True only if a trusted proxy removes client-supplied X-Forwarded-Proto.
TRUST_PROXY_SSL_HEADER=False
SCHEDULER_PREPROCESSING_TIME_LIMIT_SECONDS=10
SCHEDULER_MAX_CANDIDATES=100000
SCHEDULER_MAX_SLOT_LITERALS=2000000
